# Microchip XEC Capture/Compare Timer kernel timer driver
#
# Copyright (c) 2026 Microchip Technology Inc.
# SPDX-License-Identifier: Apache-2.0

config MCHP_XEC_CCT_TIMER
	bool "Microchip XEC Capture/Compare Timer kernel timer"
	default y
	depends on DT_HAS_MICROCHIP_XEC_CCT_TIMER_ENABLED
	select TICKLESS_CAPABLE
	select SYSTEM_TIMER_HAS_DISABLE_SUPPORT
	select SYSTEM_TIMER_HAS_LPM_COMPANION_SUPPORT
	help
	  Kernel system timer driver using the Microchip XEC Input Capture and
	  Compare Timer. The free-running 32-bit counter is the cycle source and
	  Compare 0 is the tick deadline, giving a high resolution kernel timer
	  from a single hardware block.

	  The block pauses while the SoC asserts SLEEP_ALL, so it does not count
	  the sleep interval. That interval is recovered from the always-on
	  32 KHz RTOS timer through the system timer low-power companion
	  interface.

if MCHP_XEC_CCT_TIMER

# The block pauses, and drops its clock request, while the SoC asserts
# SLEEP_ALL, so it does not count the sleep interval (measured on hardware; the
# count itself survives). That interval is recovered from a low-power companion
# selected by the generic SYSTEM_TIMER_LPM_COMPANION choice, see
# Kconfig.system_timer_lpm:
#
#   * COMPANION_HOOKS   - this driver drives the always-on RTOS timer named by
#                         the node's companion-timer phandle. The only workable
#                         mode today: the RTOS timer has no Counter API driver,
#                         and the generic counter hooks only handle up-counting
#                         timers while the RTOS timer counts down.
#   * COMPANION_COUNTER - a Counter API device named by
#                         chosen { zephyr,system-timer-companion }.
#
# SYSTEM_TIMER_RESET_BY_LPM is deliberately NOT selected: it describes a timer
# placed under reset by the low-power mode, and this block is only paused.

endif # MCHP_XEC_CCT_TIMER
