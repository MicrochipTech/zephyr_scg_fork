# Microchip XEC Capture/Compare Timer kernel timer driver
#
# Copyright (c) 2026 Microchip Technology Inc.
# SPDX-License-Identifier: Apache-2.0

config MCHP_XEC_CCT_TIMER
	bool "Microchip XEC Capture/Compare Timer kernel timer"
	default y
	depends on DT_HAS_MICROCHIP_XEC_CCT_TIMER_ENABLED
	select TICKLESS_CAPABLE
	select SYSTEM_TIMER_HAS_DISABLE_SUPPORT
	select SYSTEM_TIMER_HAS_LPM_COMPANION_SUPPORT
	help
	  Kernel system timer driver using the Microchip XEC Input Capture and
	  Compare Timer. The free-running 32-bit counter is the cycle source and
	  Compare 0 is the tick deadline, giving a high resolution kernel timer
	  from a single hardware block.

	  The counter runs on the PLL clock domain and stops in deep sleep, so
	  low-power timekeeping is delegated to the always-on 32 KHz RTOS timer
	  through the system timer low-power companion interface.

if MCHP_XEC_CCT_TIMER

# The free-running counter is gated with the PLL in deep sleep, so it cannot
# keep time there. The generic SYSTEM_TIMER_LPM_COMPANION choice (see
# Kconfig.system_timer_lpm) selects how timekeeping is handed over:
#
#   * COMPANION_HOOKS   - this driver drives the always-on RTOS timer directly.
#                         Requires "rtos" entries in reg and interrupts.
#                         This is the only workable mode today: the RTOS timer
#                         has no Counter API driver, and the generic counter
#                         hooks only handle up-counting timers.
#   * COMPANION_COUNTER - a Counter API device named by
#                         chosen { zephyr,system-timer-companion }.
config MCHP_XEC_CCT_TIMER_RESET_BY_LPM
	bool "Free-running counter loses time in deep sleep"
	default y
	depends on !SYSTEM_TIMER_LPM_COMPANION_NONE
	select SYSTEM_TIMER_RESET_BY_LPM
	help
	  Select when the platform may enter a deep-sleep state that gates the
	  PLL feeding the capture/compare block. The driver then stops the
	  counter on idle entry and recovers the slept interval from the
	  companion on wake.

endif # MCHP_XEC_CCT_TIMER
